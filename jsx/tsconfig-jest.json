{
  "include": ["src/**/*", "test/**/*"],

  "compilerOptions": {
    "allowJs": true,
    "declaration": false,
    "target": "ES2020",
    "module": "node16",
    "moduleResolution": "node16",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "types": [
      "node",
      "jest"
    ]
  },
}
