{
  "include": ["src/**/*"],

  "compilerOptions": {
    "allowJs": true,
    "declaration": true,
    "outDir": "lib",
    "declarationDir": "types",
    "target": "ES2020",
    "module": "node16",
    "moduleResolution": "node16",
    "skipLibCheck": true,
    "strictNullChecks": true,
    "esModuleInterop": false,
    "isolatedModules": true,
    "types": [
      "estree",
      "json-schema",
      "jest",
    ]
  },
}
