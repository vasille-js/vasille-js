{
  "include": ["./**/*.ts", "./**/*.tsx"],

  "compilerOptions": {
    "allowJs": true,
    "declaration": false,
    "noEmit": true,
    "target": "ES2024",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "jsxImportSource": "steel-frame",
    "skipLibCheck": true,
    "strictNullChecks": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "lib": ["ES2024", "DOM"],
    "types": ["jest", "node"]
  }
}
