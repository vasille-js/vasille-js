{
  "include": ["./**/*.ts"],

  "compilerOptions": {
    "allowJs": true,
    "declaration": false,
    "noEmit": true,
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "jsxImportSource": null,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "esModuleInterop": true,
    "types": ["jest", "node"]
  }
}
