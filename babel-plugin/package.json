{
  "name": "babel-plugin-vasille",
  "version": "5.1.1",
  "description": "Convert Vasille Meta Language code to pure JavaScript",
  "main": "lib/index.js",
  "type": "commonjs",
  "exports": {
    "import": "./lib/index.js",
    "browser": "./lib/index.js",
    "node": "./lib/index.js",
    "require": "./lib/index.js"
  },
  "scripts": {
    "prepack": "cp -f ../README.md ./README.md",
    "prettier": "prettier src test/**/*.ts* test/*.ts --write",
    "build": "tsc --build tsconfig-build.json",
    "tsc-tests": "tsc --build test/tsconfig.json",
    "test": "jest",
    "test-coverage": "jest --coverage"
  },
  "keywords": [
    "front-end",
    "framework",
    "web",
    "compiler",
    "babel"
  ],
  "author": "lixcode",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/vasille-js/vasille-js/issues"
  },
  "homepage": "https://github.com/vasille-js/vasille-js#readme",
  "devDependencies": {
    "@babel/parser": "^7.28.0",
    "@babel/plugin-syntax-jsx": "^7.27.1",
    "@babel/plugin-transform-typescript": "^7.28.0",
    "@babel/types": "^7.28.2",
    "@types/babel__core": "^7.20.5",
    "@types/jest": "^30.0.0",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^24.2.1",
    "cross-env": "^10.0.0",
    "jest": "^30.0.5",
    "jsdom": "^26.1.0",
    "path": "^0.12.7",
    "prettier": "^3.6.2",
    "steel-frame": "file:../steel-frame",
    "ts-jest": "^29.4.1",
    "typescript": "^5.9.2",
    "vasille": "file:../core"
  }
}
