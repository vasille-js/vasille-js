{
  "include": ["src/**/*"],

  "compilerOptions": {
    "allowJs": true,
    "declaration": true,
    "outDir": "lib",
    "declarationDir": "types",
    "target": "ES2015",
    "module": "Node16",
    "moduleResolution": "node16",
    "skipLibCheck": true,
    "strictNullChecks": true,
    "esModuleInterop": false,
    "types": ["jest"]
  }
}
