{
  "include": ["src/**/*"],

  "compilerOptions": {
    "allowJs": true,
    "declaration": true,
    "outDir": "lib",
    "declarationDir": "types",
    "target": "ES2020",
    "module": "Node16",
    "moduleResolution": "node16",
    "jsx": "preserve",
    "jsxImportSource": "steel-frame",
    "skipLibCheck": true,
    "strictNullChecks": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "lib": ["ES2024"],
    "types": ["node"]
  }
}
