{
  "name": "vasille-ssg",
  "version": "5.0.1",
  "description": "The same devkit which is designed to build fault tolerant frontends. (SSG alternative library)",
  "main": "index.js",
  "exports": {
    "types": "./types/index.d.ts",
    "import": "./lib/index.js",
    "browser": "./lib/index.js",
    "node": "./lib/index.js"
  },
  "scripts": {
    "prepack": "cp -f ../README.md ./README.md",
    "prettier": "prettier src test/**/*.tsx test/**/*.ts test/run-test.ts --write",
    "prebuild": "rm -rf lib types",
    "build": "tsc --build tsconfig.json",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest",
    "test-coverage": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --coverage"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vasille-js/vasille-js.git"
  },
  "keywords": [
    "frontend",
    "dx",
    "fast",
    "simple",
    "secure"
  ],
  "author": "lixcode",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/vasille-js/vasille-js/issues"
  },
  "homepage": "https://github.com/vasille-js/vasille-js#readme",
  "dependencies": {
    "csstype": "^3.1.3",
    "escape-html": "^1.0.3",
    "vasille": "^5.1.0",
    "vasille-context": "^5.0.0",
    "vasille-jsx": "^5.0.1",
    "vasille-router": "^5.0.0"
  },
  "devDependencies": {
    "@babel/plugin-syntax-jsx": "^7.27.1",
    "@babel/plugin-transform-typescript": "^7.28.0",
    "@types/escape-html": "^1.0.4",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.3.0",
    "babel-jest": "^30.1.2",
    "babel-plugin-vasille": "file:../babel-plugin",
    "cross-env": "^10.0.0",
    "jest": "^30.3.0",
    "prettier": "^3.6.2",
    "steel-frame": "file:../steel-frame",
    "typescript": "^5.8.3",
    "vasille-web": "file:../web"
  }
}
