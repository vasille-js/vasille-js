{
  "name": "vasille-router",
  "description": "The same devkit which is designed to build fault tolerant frontends (router library).",
  "main": "lib/index.js",
  "types": "types/index.d.ts",
  "version": "6.0.0-rc",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./lib/index.js",
      "browser": "./lib/index.js",
      "node": "./lib/index.js"
    },
    "./web-router": {
      "types": "./types/web/router.d.ts",
      "import": "./lib/web/router.js",
      "browser": "./lib/web/router.js",
      "node": "./lib/web/router.js"
    },
    "./dev": {
      "types": "./types/web/dev.d.ts",
      "import": "./lib/web/dev.js",
      "browser": "./lib/web/dev.js",
      "node": "./lib/web/dev.js"
    }
  },
  "scripts": {
    "prepack": "cp -f ../README.md ./README.md",
    "prettier": "npx prettier src test --write",
    "prebuild": "rm -rf lib types",
    "build": "tsc --build tsconfig.json",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest",
    "test-coverage": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vasille-js/vasille-js.git"
  },
  "type": "module",
  "keywords": [
    "front-end",
    "web",
    "app",
    "safe",
    "simple",
    "powerful"
  ],
  "author": "lixcode",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/vasille-js/vasille-js/issues"
  },
  "homepage": "https://github.com/vasille-js/vasille-js#readme",
  "devDependencies": {
    "@types/debug": "^4.1.12",
    "@types/eslint": "^9.6.1",
    "@types/eslint-scope": "^8.3.1",
    "@types/estree": "^1.0.8",
    "@types/events": "^3.0.3",
    "@types/jest": "^30.0.0",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^24.2.1",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "cross-env": "^10.0.0",
    "eslint-plugin-compat": "^6.0.2",
    "jest": "^30.0.5",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.0",
    "tslint-config-prettier": "^1.18.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.39.0"
  },
  "dependencies": {
    "vasille": "6.0.0-rc.4",
    "vasille-jsx": "^6.0.0-rc.2"
  }
}
