{
  "include": ["src/**/*"],

  "compilerOptions": {
    "allowJs": true,
    "declaration": false,
    "outDir": "lib",
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strictNullChecks": true,
    "isolatedModules": true,
    "types": [
      "debug",
      "node",
      "estree",
      "events",
      "jest",
      "json-schema"
    ]
  },
}
