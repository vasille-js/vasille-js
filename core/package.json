{
  "name": "vasille",
  "description": "The same framework which is designed to build bulletproof frontends (core library).",
  "main": "lib/index.js",
  "types": "types/index.d.ts",
  "version": "5.1.9",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./lib/index.js",
      "browser": "./lib/index.js",
      "node": "./lib/index.js"
    },
    "./dev": {
      "types": "./types/dev/index.d.ts",
      "import": "./lib/dev/index.js",
      "browser": "./lib/dev/index.js",
      "node": "./lib/dev/index.js"
    },
    "./web-runner": {
      "types": "./types/runner/web/runner.d.ts",
      "import": "./lib/runner/web/runner.js",
      "browser": "./lib/runner/web/runner.js",
      "node": "./lib/runner/web/runner.js"
    }
  },
  "scripts": {
    "prepack": "cp -f ../README.md ./README.md",
    "prettier": "npx prettier src test --write",
    "prebuild": "rm -rf types lib",
    "build": "tsc --build tsconfig.json",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest",
    "test-coverage": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vasille-js/vasille-js.git"
  },
  "type": "module",
  "keywords": [
    "front-end",
    "web",
    "app",
    "safe",
    "simple",
    "poweful"
  ],
  "author": "lixcode",
  "license": "MIT",
  "browserslist": [
    "safari 6",
    "ie 10",
    "chrome 23",
    "firefox 21",
    "opera 15"
  ],
  "bugs": {
    "url": "https://github.com/vasille-js/vasille-js/issues"
  },
  "homepage": "https://github.com/vasille-js/vasille-js#readme",
  "devDependencies": {
    "@types/debug": "^4.1.12",
    "@types/eslint": "^9.6.1",
    "@types/eslint-scope": "^8.3.1",
    "@types/estree": "^1.0.8",
    "@types/events": "^3.0.3",
    "@types/jest": "^30.0.0",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^24.2.1",
    "cross-env": "^10.0.0",
    "eslint": "^9.33.0",
    "eslint-plugin-compat": "^6.0.2",
    "jest": "^30.0.5",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.0",
    "tslint-config-prettier": "^1.18.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.39.0"
  }
}
