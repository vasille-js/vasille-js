{
  "name": "vasille-context",
  "version": "5.0.0",
  "description": "Provide contextual data between Vasille.JS components",
  "keywords": [
    "frontend",
    "framework",
    "safe",
    "fast",
    "simple"
  ],
  "license": "MIT",
  "author": "lixcode",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
      ".": {
          "types": "./types/index.d.ts",
          "import": "./lib/index.js",
          "browser": "./lib/index.js"
      }
  },
  "scripts": {
    "prepack": "cp -f ../README.md ./README.md",
    "prettier": "npx prettier src test --write",
    "prebuild": "rm -rf types lib",
    "build": "tsc --build tsconfig.json",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest",
    "test-coverage": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vasille-js/steel-frame.git"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "cross-env": "^10.1.0",
    "jest": "^30.2.0",
    "prettier": "^3.8.1",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "vasille": "^5.0.0"
  }
}
