{
  "name": "vasille-web",
  "version": "3.2.1",
  "description": "The first Developer eXperience Orientated web front-end framework.",
  "main": "index.js",
  "types": "./index.d.ts",
  "bin": {
    "vasille-web": "./lib/bin.js"
  },
  "exports": {
    ".": {
      "types": "./fake-types/index.d.ts",
      "import": "./lib/index.js",
      "browser": "./lib/index.js",
      "node": "./lib/index.js"
    },
    "./jsx-runtime": {
      "types": "./types/jsx-runtime.d.ts",
      "import": "./lib/jsx-runtime.js",
      "browser": "./lib/jsx-runtime.js",
      "node": "./lib/jsx-runtime.js"
    }
  },
  "scripts": {
    "prepack": "cp -f ../README.md ./README.md",
    "prettier": "prettier src fake-types --write",
    "build": "tsc --build tsconfig.json",
    "check-types": "tsc --noEmit --lib es2020 --types web --moduleResolution Node16 --module Node16 ./fake-types/index.d.ts"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vasille-js/vasille-js.git"
  },
  "keywords": [
    "frontend",
    "dx",
    "fast",
    "simple",
    "secure"
  ],
  "author": "lixcode",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/vasille-js/vasille-js/issues"
  },
  "homepage": "https://github.com/vasille-js/vasille-js#readme",
  "dependencies": {
    "csstype": "^3.1.3",
    "vasille": "file:../core",
    "vasille-css": "file:../css",
    "vasille-jsx": "file:../jsx",
    "vasille-router": "file:../router"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/web": "^0.0.256",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3"
  }
}
